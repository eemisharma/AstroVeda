# ==========================================
# ASTROCONSULT PWA ENVIRONMENT CONFIGURATION
# ==========================================

# Database: Default SQLite for zero-config local dev, or PostgreSQL for production
# e.g. postgresql://postgres:password@localhost:5432/astroconsult?schema=public
DATABASE_URL="file:./dev.db"

# Authentication secret
AUTH_SECRET="astro-consult-jwt-secret-key-production-ready-minimum-32-chars"
JWT_EXPIRES_IN="7d"

# Razorpay Credentials (Test mode for development)
# When empty or using test placeholder, the built-in Test Payment Simulator activates
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_placeholder_webhook"

# External Astrology API (optional - high-precision fallback engine is included)
ASTROLOGY_API_KEY=""
ASTROLOGY_API_URL=""

# AI Engine API Key (Gemini API or compatible LLM)
AI_API_KEY=""

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
NEXT_PUBLIC_WHATSAPP_SUPPORT_PHONE="919876543210"

# Marketing & Tracking
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_ID=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3010"

# Demo Mode (Simulates instant payment & real-time report generation for development/testing)
DEMO_MODE="true"
